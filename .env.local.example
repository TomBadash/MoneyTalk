# Copy this file to ".env.local" and fill in the values from your Supabase project.
# (Supabase dashboard → Project Settings → API)
#
# These two are PUBLIC and safe to expose to the browser — access is protected
# by Row Level Security in the database. Do NOT put the service_role key here.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# Current Supabase projects call this the "publishable" key (sb_publishable_…).
# Older projects use NEXT_PUBLIC_SUPABASE_ANON_KEY instead — either works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

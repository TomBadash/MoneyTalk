# Copy to ".env.local". Without the Supabase values the app runs in a local in-memory demo mode.

# ── Supabase (PUBLIC; protected by Row Level Security) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# Newer projects: "publishable" key (sb_publishable_…). Older: NEXT_PUBLIC_SUPABASE_ANON_KEY — either works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ── SERVER-ONLY secrets (never prefix with NEXT_PUBLIC_) ──
# Needed for the API-key endpoint, the daily cron job and account deletion.
SUPABASE_SERVICE_ROLE_KEY=
# Encrypts provider tokens at rest:  openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Protects /api/cron/daily (Vercel Cron sends it as a Bearer token):  openssl rand -hex 24
CRON_SECRET=

# ── Optional AI (everything works without it) ──
ANTHROPIC_API_KEY=
# MONEYTALK_AI_MODEL=claude-opus-5-5

# ── Local mode only (no Supabase): key accepted by POST /api/v1/expense ──
# MONEYTALK_DEV_API_KEY=mt_dev_change_me_0123456789
